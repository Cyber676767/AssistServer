{
  "rewrites": [
    { "source": "/api/status", "destination": "/api/status.js" },
    { "source": "/api/incidents", "destination": "/api/incidents.js" },
    { "source": "/api/important-banner", "destination": "/api/important-banner.js" },
    { "source": "/api/monitors", "destination": "/api/monitors.js" },
    { "source": "/api/(.*)", "destination": "/api/$1.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    }
  ]
}
